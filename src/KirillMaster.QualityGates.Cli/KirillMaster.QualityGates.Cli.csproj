<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>qg</ToolCommandName>
    <PackageId>KirillMaster.QualityGates.Cli</PackageId>
    <Description>qg dotnet tool: PR and new-code gates, baseline ratchet, coverage, duplication, format, size, coupling, fan-out, architecture and complexity deltas, mutation budget and debt report for CI.</Description>
    <PackageTags>quality-gates;ci;ratchet;dotnet-tool</PackageTags>
    <RootNamespace>KirillMaster.QualityGates.Cli</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-default</AnalysisLevel>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <InternalsVisibleTo Include="KirillMaster.QualityGates.Cli.Tests" />
  </ItemGroup>
</Project>
