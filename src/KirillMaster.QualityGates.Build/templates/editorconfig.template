root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_prefer_braces = true:warning

[*.{csproj,props,targets,json,yml,yaml}]
indent_size = 2

# Thresholds for QG0001-QG0006 and QG0042 (defaults shown)
# qg_max_type_lines = 300
# qg_max_method_lines = 60
# qg_max_complexity = 10
# qg_max_nesting = 3
# qg_max_parameters = 5
# qg_max_dependencies = 7
# qg_max_asserts = 5
# qg_max_cognitive_complexity = 15
# qg_max_method_fan_out = 10
# qg_min_shallow_methods = 3
# qg_max_pass_through_percent = 75
# qg_banned_name_suffixes = Helper,Helpers,Util,Utils,Utility,Utilities,Manager,Misc,Stuff,Thing,Impl,Holder,Common
# qg_abbreviation_tokens = svc,cmd,evt,src,mgr,cfg,tmp,num,req,res,opt,str,cb

# QG0007, QG0008, QG0033-QG0036, QG0050, QG0051: warning in strict; legacy-ratchet makes QG0033-QG0036, QG0050, QG0051 suggestions

# Opt-in analyzers (disabled by default)
# dotnet_diagnostic.QG0031.severity = warning
# dotnet_diagnostic.QG0032.severity = warning
