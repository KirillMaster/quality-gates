<Project>
  <!-- Mode: QualityGatesMode (adopt default | refactor); QUALITYGATES_MODE env var is read when the property is empty.
       QualityGatesRefactorScope: optional ';' list of project-name prefixes (trailing * allowed, blanks skipped); projects outside keep adopt. -->
  <PropertyGroup Condition="'$(QualityGatesEnabled)' != 'false'">
    <QualityGatesMode Condition="'$(QualityGatesMode)' == ''">$(QUALITYGATES_MODE)</QualityGatesMode>
    <QualityGatesMode Condition="'$(QualityGatesMode)' == ''">adopt</QualityGatesMode>
    <QualityGatesEffectiveMode>adopt</QualityGatesEffectiveMode>
    <QualityGatesGrandfatheredFile>$(QualityGatesGrandfatheredDir)$(MSBuildProjectName).GlobalSuppressions.cs</QualityGatesGrandfatheredFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(QualityGatesEnabled)' != 'false' and '$(QualityGatesMode)' == 'refactor'">
    <_QualityGatesScope Include="$([MSBuild]::Unescape($(QualityGatesRefactorScope.Replace('*', ''))))">
      <Hit>$(MSBuildProjectName.StartsWith('%(Identity)', System.StringComparison.Ordinal))</Hit>
    </_QualityGatesScope>
    <_QualityGatesRefactor Include="$(MSBuildProjectName)" Condition="'@(_QualityGatesScope)' == '' or @(_QualityGatesScope->AnyHaveMetadataValue('Hit', 'True'))" />
  </ItemGroup>
  <ItemGroup Condition="'$(QualityGatesEnabled)' != 'false'">
    <AdditionalFiles Condition="'$(QualityGatesGlossary)' != '' and Exists('$(QualityGatesGlossary)')" Include="$(QualityGatesGlossary)" />
    <AdditionalFiles Condition="'$(QualityGatesBannedSymbols)' != 'false'" Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
    <!-- Design bans report RS0030 (an error): opt-in with QualityGatesDesignBans=true until the consumer grandfathers its legacy hits. -->
    <AdditionalFiles Condition="'$(QualityGatesBannedSymbols)' != 'false' and '$(QualityGatesDesignBans)' == 'true' and '$(QualityGatesLayer)' != 'excluded'" Include="$(MSBuildThisFileDirectory)BannedSymbols.All.txt" />
    <AdditionalFiles Condition="'$(QualityGatesBannedSymbols)' != 'false' and '$(QualityGatesDesignBans)' == 'true' and '$(QualityGatesLayer)' == 'core'" Include="$(MSBuildThisFileDirectory)BannedSymbols.Core.txt" />
    <AdditionalFiles Condition="'$(QualityGatesBannedSymbols)' != 'false' and '$(QualityGatesDesignBans)' == 'true' and '$(QualityGatesLayer)' == 'core'" Include="$(MSBuildThisFileDirectory)BannedSymbols.CoreDesign.txt" />
    <AdditionalFiles Condition="'$(QualityGatesBannedSymbols)' != 'false' and '$(QualityGatesDesignBans)' == 'true' and '$(QualityGatesLayer)' == 'core' and '$(QualityGatesCoreModel)' == 'true'" Include="$(MSBuildThisFileDirectory)BannedSymbols.Model.txt" />
    <AdditionalFiles Condition="'$(QualityGatesBannedSymbols)' != 'false' and '$(QualityGatesDesignBans)' == 'true' and '$(QualityGatesLayer)' == 'test'" Include="$(MSBuildThisFileDirectory)BannedSymbols.Test.txt" />
    <Compile Condition="'@(_QualityGatesRefactor)' == '' and Exists('$(QualityGatesGrandfatheredFile)')" Include="$(QualityGatesGrandfatheredFile)" Link="quality/GlobalSuppressions.Grandfathered.cs" />
    <GlobalAnalyzerConfigFiles Condition="'@(_QualityGatesRefactor)' != ''" Include="$(MSBuildThisFileDirectory)quality.refactor.globalconfig" />
  </ItemGroup>
  <!-- Items cannot feed property conditions at evaluation, so the effective mode and TreatWarningsAsErrors are set here, before compilation. -->
  <Target Name="QualityGatesResolveMode" BeforeTargets="CoreCompile" Condition="'$(QualityGatesEnabled)' != 'false'">
    <PropertyGroup Condition="'@(_QualityGatesRefactor)' != ''">
      <QualityGatesEffectiveMode>refactor</QualityGatesEffectiveMode>
      <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>
  </Target>
</Project>
