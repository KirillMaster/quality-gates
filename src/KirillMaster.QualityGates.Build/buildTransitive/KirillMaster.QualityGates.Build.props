<Project>
  <!-- Opt out with QualityGatesEnabled=false (Directory.Build.props or /p:). Profiles: strict (default) | legacy-ratchet. -->
  <PropertyGroup>
    <QualityGatesEnabled Condition="'$(QualityGatesEnabled)' == ''">true</QualityGatesEnabled>
    <QualityGatesProfile Condition="'$(QualityGatesProfile)' == ''">strict</QualityGatesProfile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(QualityGatesEnabled)' != 'false'">
    <TreatWarningsAsErrors Condition="'$(TreatWarningsAsErrors)' == ''">true</TreatWarningsAsErrors>
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
    <EnforceCodeStyleInBuild Condition="'$(EnforceCodeStyleInBuild)' == ''">true</EnforceCodeStyleInBuild>
    <QualityGatesLayer Condition="'$(QualityGatesLayer)' == '' and ($(MSBuildProjectName.EndsWith('.Tests')) or $(MSBuildProjectName.EndsWith('.Test')))">test</QualityGatesLayer>
    <QualityGatesLayer Condition="'$(QualityGatesLayer)' == '' and ($(MSBuildProjectName.EndsWith('.Domain')) or $(MSBuildProjectName.EndsWith('.Application')))">core</QualityGatesLayer>
    <QualityGatesLayer Condition="'$(QualityGatesLayer)' == ''">adapter</QualityGatesLayer>
    <Deterministic Condition="'$(Deterministic)' == ''">true</Deterministic>
    <AnalysisLevel Condition="'$(AnalysisLevel)' == '' and '$(QualityGatesProfile)' == 'legacy-ratchet'">latest-recommended</AnalysisLevel>
    <AnalysisLevel Condition="'$(AnalysisLevel)' == ''">latest-all</AnalysisLevel>
    <QualityGatesRepoRoot Condition="'$(QualityGatesRepoRoot)' == ''">$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', 'Directory.Build.props'))</QualityGatesRepoRoot>
    <QualityGatesRepoRoot Condition="'$(QualityGatesRepoRoot)' == ''">$(MSBuildProjectDirectory)</QualityGatesRepoRoot>
    <QualityGatesGrandfatheredDir Condition="'$(QualityGatesGrandfatheredDir)' == ''">$([MSBuild]::EnsureTrailingSlash('$(QualityGatesRepoRoot)'))quality/grandfathered/</QualityGatesGrandfatheredDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(QualityGatesEnabled)' != 'false'">
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)quality.globalconfig" />
    <GlobalAnalyzerConfigFiles Condition="'$(QualityGatesLayer)' == 'test'" Include="$(MSBuildThisFileDirectory)quality.tests.globalconfig" />
  </ItemGroup>
</Project>
