<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoWarn>$(NoWarn);NU5128;NU5100</NoWarn>
    <PackageId>KirillMaster.QualityGates.Build</PackageId>
    <Description>Quality gates for modern .NET: warnings-as-errors, curated third-party analyzers, generic Roslyn analyzers (QG0xxx), banned symbols, grandfathered suppressions. Build-only, no runtime dependency.</Description>
    <PackageTags>quality;analyzers;roslyn;build;static-analysis;quality-gates</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\KirillMaster.QualityGates.Analyzers\KirillMaster.QualityGates.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" />
    <PackageReference Include="Meziantou.Analyzer" />
    <PackageReference Include="Roslynator.Analyzers" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" />
    <PackageReference Include="IDisposableAnalyzers" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\KirillMaster.QualityGates.Analyzers\bin\$(Configuration)\netstandard2.0\KirillMaster.QualityGates.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive" />
    <None Include="templates\**" Pack="true" PackagePath="templates" />
  </ItemGroup>
</Project>
